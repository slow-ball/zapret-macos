--filter-tcp="@GAME_TCP@"
--ipset="@GAMEIPSET@"
--ipset-exclude="@LISTS@/ipset-exclude.txt"
--ipset-exclude="@LISTS@/ipset-exclude-user.txt"
--dpi-desync=fake,hostfakesplit
--dpi-desync-any-protocol=1
--dpi-desync-cutoff=n4
--dpi-desync-fooling=ts
--dpi-desync-hostfakesplit-mod=host=mail.ru,altorder=1
--dpi-desync-repeats=5
--dpi-desync-fake-tls="@BASE@/bin/tls_clienthello_sochi_park.bin"
--dpi-desync-fake-tls="@BASE@/bin/stun2.bin"
--dpi-desync-fake-http="@BASE@/bin/tls_clienthello_sochi_park.bin"
--dpi-desync-fake-unknown="@BASE@/bin/tls_clienthello_sochi_park.bin"
--dpi-desync-fake-unknown="@BASE@/bin/stun2.bin"
